# =====================================================
# Custo Certo - Variáveis de Ambiente (MODELO)
# =====================================================
# Copie este arquivo para ".env" e preencha os valores.
# O ".env" real NUNCA deve ser comitado (está no .gitignore).

NODE_ENV=development
PORT=3000

# Roda a carga inicial automática se a tabela de ingredientes estiver vazia
AUTO_SEED=true

# --- Banco de dados (MySQL) ---
# O painel web lê e escreve nas MESMAS tabelas que a aplicação desktop em Java.
# Os nomes abaixo correspondem, um a um, às chaves de
# desktop/config.properties.example — se o desktop já está funcionando nesta
# máquina, copie os valores de lá.
#
#   DB_HOST     máquina onde o MySQL está rodando.
#               Desenvolvendo sozinho: localhost.
#               Demonstrando o acesso via rede local: o IP da máquina que estiver
#               servindo o banco (descubra com "ipconfig" nela).
#   DB_USER     use a conta "custocerto", que é a liberada para acesso pela rede
#               e tem permissão apenas no banco custo_certo. A conta root só
#               responde em localhost.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=custo_certo
DB_USER=custocerto
DB_PASSWORD=

# Opcional: domínios autorizados em produção (separados por vírgula)
# Ex.: ALLOWED_ORIGINS=https://custo-certo.onrender.com
ALLOWED_ORIGINS=
