; =====================================================
; MODELO de credenciais do firmware
; =====================================================
; Copie este arquivo para "secrets.ini" e preencha com os
; valores reais. O "secrets.ini" NAO e versionado (.gitignore).

[secrets]
wifi_ssid       = NOME_DA_REDE_WIFI
wifi_pass       = SENHA_DA_REDE_WIFI

; A balanca agora e um dispositivo de rede: ela sobe um servidor HTTP e
; responde a quem perguntar o peso. Os dois aplicativos do Custo Certo
; consultam a balanca diretamente, cada um por conta propria.
;
; As URLs abaixo sao do ENVIO REMOTO, que e opcional e existe apenas para
; manter viavel um painel hospedado fora da rede da cafeteria -- um servidor
; na nuvem jamais alcancaria um ESP32 atras do roteador.
;
; DEIXE VAZIO para operar so na rede local, que e o mais leve e o que sera
; usado na apresentacao:
;
;   server_url_dev  =
;
server_url_dev  =
server_url_prod = https://custo-certo.onrender.com
